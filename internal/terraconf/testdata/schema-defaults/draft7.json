{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "a": { "type": "integer", "default": 1 } }
      }
    },
    "tuple": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": { "first": { "type": "string", "default": "x" } }
        }
      ],
      "additionalItems": {
        "type": "object",
        "properties": { "rest": { "type": "string", "default": "y" } }
      }
    }
  }
}
